// Veltriance Procurement Platform — Database Schema
// Run `npx prisma db push` after setting DATABASE_URL to sync this to Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Organizations (Tenants) ─────────────────────────────
// Each client company is one Organization. `slug` is the subdomain they sign in at,
// e.g. acme.veltriance-platform.com → slug = "acme". Every other model below is
// scoped to an organizationId, and every query in the app must filter by it —
// see lib/tenant.ts for the helper that makes this hard to forget.

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // subdomain — lowercase, no spaces, e.g. "acme"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  suppliers    Supplier[]
  requisitions Requisition[]

  @@index([slug])
}

// ───────────────────────────── Users & Roles ─────────────────────────────

enum Role {
  REQUESTOR
  APPROVER
  PROCUREMENT
  ADMIN
}

model User {
  id                String   @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authId            String   @unique // Supabase auth.users.id
  email             String   @unique
  name              String
  employeeId        String?
  department        String?
  businessUnit      String?
  costCenter        String?
  country           String?
  currency          String   @default("USD")
  role              Role     @default(REQUESTOR)
  managerId         String?
  manager           User?    @relation("ManagerReports", fields: [managerId], references: [id])
  reports           User[]   @relation("ManagerReports")
  onboardingComplete Boolean @default(false)
  invitedAt         DateTime?  // set when created via an admin invite, vs self-signup
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  requisitionsCreated Requisition[]      @relation("RequisitionRequestor")
  approvalSteps        ApprovalStep[]
  supplierRequests      Supplier[]        @relation("SupplierRequestedBy")

  @@index([role])
  @@index([department])
  @@index([organizationId])
  @@unique([organizationId, employeeId])
}

// ───────────────────────────── Suppliers ─────────────────────────────

enum SupplierStatus {
  ACTIVE
  PENDING_APPROVAL
  BLOCKED
  INACTIVE
}

model Supplier {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  code            String?
  taxId           String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  country         String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  paymentTerms    String?
  category        String?
  rating          Float?         // 0–5, populated over time
  preferred       Boolean        @default(false)
  status          SupplierStatus @default(PENDING_APPROVAL)
  businessJustification String?
  requestedById   String?
  requestedBy     User?          @relation("SupplierRequestedBy", fields: [requestedById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  requisitionLines RequisitionLineItem[]

  @@index([status])
  @@index([category])
  @@index([name])
  @@index([organizationId])
  @@unique([organizationId, code])
}

// ───────────────────────────── Requisitions ─────────────────────────────

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  MANAGER_APPROVAL
  DIRECTOR_APPROVAL
  PROCUREMENT_REVIEW
  FINANCE_APPROVAL
  ERP_SYNC_PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum IntakeSource {
  FORM
  CHATBOT
}

model Requisition {
  id              String             @id @default(uuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requisitionNumber String           // e.g. REQ-2026-00001 — unique per organization, not globally
  title           String
  description     String?
  category        String?
  status          RequisitionStatus  @default(DRAFT)
  intakeSource    IntakeSource       @default(FORM)
  requestorId     String
  requestor       User               @relation("RequisitionRequestor", fields: [requestorId], references: [id])
  costCenter      String?
  deliveryLocation String?
  requiredDate    DateTime?
  currency        String             @default("USD")
  totalAmount     Decimal            @default(0) @db.Decimal(14, 2)
  erpTargetSystem String?            // "coupa" | "sap" | "oracle" | "ivalua" — set at procurement review
  erpReferenceId  String?            // populated once pushed downstream (future sprint)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  submittedAt     DateTime?
  completedAt     DateTime?

  lineItems       RequisitionLineItem[]
  approvalSteps   ApprovalStep[]
  attachments     Attachment[]

  @@index([status])
  @@index([requestorId])
  @@index([organizationId])
  @@unique([organizationId, requisitionNumber])
}

model RequisitionLineItem {
  id              String       @id @default(uuid())
  requisitionId   String
  requisition     Requisition  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier?    @relation(fields: [supplierId], references: [id])
  description     String
  quantity        Decimal      @db.Decimal(12, 2)
  unitPrice       Decimal      @db.Decimal(12, 2)
  lineTotal       Decimal      @db.Decimal(14, 2)
  glAccount       String?
  createdAt       DateTime     @default(now())
}

model Attachment {
  id              String       @id @default(uuid())
  requisitionId   String
  requisition     Requisition  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  fileName        String
  fileUrl         String
  uploadedAt      DateTime     @default(now())
}

// ───────────────────────────── Approval Workflow ─────────────────────────────

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApprovalStepType {
  MANAGER
  DIRECTOR
  PROCUREMENT
  FINANCE
}

model ApprovalStep {
  id              String             @id @default(uuid())
  requisitionId   String
  requisition     Requisition        @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stepType        ApprovalStepType
  sequence        Int                // order within the requisition's workflow
  approverId      String?
  approver        User?              @relation(fields: [approverId], references: [id])
  status          ApprovalStepStatus @default(PENDING)
  comment         String?
  decidedAt       DateTime?
  createdAt       DateTime           @default(now())

  @@index([requisitionId])
  @@index([approverId, status])
}
