// Veltriance Procurement Platform — Database Schema
// Run `npx prisma db push` after setting DATABASE_URL to sync this to Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Organizations (Tenants) ──────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Licensing ── set by the platform operator (see /api/platform/.../license),
  // never by the customer. Defaults match what every org had before licensing
  // existed, so introducing these columns doesn't take anything away.
  plan             String          @default("PROCURE_PLUS")
  licensedModules  LicenseModule[] @default([INTAKE_TO_PO, SUPPLIER_RISK])
  licenseExpiresAt DateTime?       // null = no expiry
  seatLimit        Int?            // null = unlimited

  // How much an agent may do without asking (see lib/agents/runtime.ts).
  // SUGGEST is the safe default: every write waits for a human to approve it.
  agentAutonomy    AgentAutonomy   @default(SUGGEST)

  users           User[]
  suppliers       Supplier[]
  requisitions    Requisition[]
  purchaseOrders  PurchaseOrder[]
  approvalRules   ApprovalRule[]
  customFields    CustomField[]
  lookups         Lookup[]
  chartOfAccounts ChartOfAccount[]
  roles           WorkspaceRole[]
  contentGroups   ContentGroup[]
  integrations    Integration[]
  apiClients      ApiClient[]
  catalogs        Catalog[]
  punchoutSessions PunchoutSession[]
  agentRuns        AgentRun[]
  contracts        Contract[]
  sourcingEvents   SourcingEvent[]
  contractClauses  ContractClause[]
  agentActions     AgentAction[]

  @@index([slug])
}

// Sellable capabilities. An org can hold any combination, so a customer can buy
// just Intake-to-PO or the whole suite. See lib/license-catalog.ts.
enum LicenseModule {
  INTAKE_TO_PO   // requisitions, approvals, catalogs, purchase orders
  SUPPLIER_RISK  // supplier onboarding, documents, risk assessment
  SOURCING       // RFx events and bidding
  CONTRACTS      // negotiation, signing, published contract repository
  AGENTS         // autonomous agents that act with minimal human touch
}

// ───────────────────────────── Users & Roles ────────────────────────────────

enum Role {
  REQUESTOR
  APPROVER
  PROCUREMENT
  ADMIN
}

model User {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authId             String?      @unique
  email              String       @unique
  name               String
  employeeId         String?
  department         String?
  businessUnit       String?
  costCenter         String?
  country            String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  phone              String?
  jobTitle           String?
  inviteStatus       String?      @default("ACTIVE")
  passwordResetSentAt DateTime?   // throttles "forgot password" emails
  currency           String       @default("USD")
  role               Role         @default(REQUESTOR)
  managerId          String?
  manager            User?        @relation("ManagerReports", fields: [managerId], references: [id])
  reports            User[]       @relation("ManagerReports")
  onboardingComplete Boolean      @default(false)
  invitedAt          DateTime?
  inviteToken        String?      @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  requisitionsCreated   Requisition[]    @relation("RequisitionRequestor")
  approvalSteps         ApprovalStep[]
  supplierRequests      Supplier[]       @relation("SupplierRequestedBy")
  assignedSuppliers     Supplier[]       @relation("SupplierAssignedUser")
  purchaseOrdersCreated PurchaseOrder[]  @relation("POCreatedBy")
  userRoles             WorkspaceRoleMember[]
  contentGroupMembers   ContentGroupMember[]
  chartOfAccountAccess  UserChartOfAccount[]
  punchoutSessions      PunchoutSession[]

  @@index([role])
  @@index([department])
  @@index([organizationId])
  @@unique([organizationId, employeeId])
  ownedContracts  Contract[]     @relation("ContractOwner")
  ownedSourcing   SourcingEvent[] @relation("SourcingOwner")
}

// ───────────────────────────── Suppliers ────────────────────────────────────

enum SupplierStatus {
  ACTIVE
  PENDING_APPROVAL
  BLOCKED
  INACTIVE
}

enum SupplierOnboardingStage {
  REGISTRATION
  VALIDATION
  RISK_ASSESSMENT
  COMPLIANCE_REVIEW
  PROCUREMENT_APPROVAL
  ACTIVE
}

model Supplier {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  code            String?
  taxId           String?
  dunsNumber      String?
  website         String?
  description     String?
  tier            String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  paymentTerms    String?
  currency        String?        @default("USD")
  bankName        String?
  bankAccountNumber String?
  bankRoutingNumber String?
  category        String?
  subcategory     String?
  diversityStatus String?
  certifications  String[]
  riskScore       Float?
  riskLevel       String?
  lastRiskReview  DateTime?
  complianceScore Float?
  rating          Float?
  onTimeDelivery  Float?
  qualityScore    Float?
  responsivenessScore Float?
  invoiceAccuracy Float?
  preferred       Boolean        @default(false)
  onboardingStage SupplierOnboardingStage?
  status          SupplierStatus @default(PENDING_APPROVAL)
  businessJustification String?
  requestedById   String?
  requestedBy     User?          @relation("SupplierRequestedBy", fields: [requestedById], references: [id])
  approvedAt      DateTime?
  notes           String?
  customFieldAnswers Json?       // Record<fieldKey, value> for entity=SUPPLIER CustomFields (Dynamic Questionnaire Engine)
  riskBreakdown   Json?          // domain-by-domain risk breakdown + rationale from the last risk assessment

  // ── Self-service onboarding (vendor portal) ──
  // The vendor's personal link is a random token; only its SHA-256 hash is stored.
  portalTokenHash          String?   @unique
  portalInvitedAt          DateTime?
  portalSubmittedAt        DateTime? // the vendor says "I'm done" — ready for a human to review
  onboardingReminders      Int       @default(0)
  lastOnboardingReminderAt DateTime?
  // The onboarding agent's advice: { decision, reasoning, at }. Advice only — it never approves.
  onboardingRecommendation Json?
  erpSupplierId   String?        // vendor/supplier ID as created in the connected ERP, once synced
  erpSyncStatus   String?        // NOT_SYNCED | SYNCING | SYNCED | FAILED
  erpSyncedAt     DateTime?
  // How POs for this supplier are transmitted by default — null means fall back
  // to the PO-level default (EMAIL). cxmlEndpoint reuses the supplier's website
  // field today for CXML catalogs; this is the PO transmission endpoint instead.
  poTransmissionMethod PORoutingMethod?
  cxmlEndpoint         String?
  assignedUserId  String?
  assignedUser    User?          @relation("SupplierAssignedUser", fields: [assignedUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  contacts           SupplierContact[]
  requisitionLines   RequisitionLineItem[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLineItem[]
  catalogs           Catalog[]
  catalogItems       CatalogItem[]
  documents          SupplierDocument[]
  messages           SupplierMessage[]
  onboardingProfile  SupplierOnboardingProfile?

  @@index([status])
  @@index([category])
  @@index([name])
  @@index([organizationId])
  @@index([assignedUserId])
  @@unique([organizationId, code])
  contracts       Contract[]
  sourcingInvites SourcingInvite[]
}

model SupplierContact {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name        String
  title       String?
  email       String
  phone       String?
  department  String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([supplierId])
}

// Deep onboarding data (tax, banking, registered address, diversity flags) captured
// via the SupplierAgent bot or supplier portal — separate from the lightweight
// Supplier record so onboarding can be resumed/edited without touching core fields.
model SupplierOnboardingProfile {
  id                String   @id @default(uuid())
  supplierId        String   @unique
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  country           String?  // drives which tax/bank fields + documents are required, see lib/onboarding-requirements.ts
  legalName         String?
  businessType      String?
  panNumber         String?  // India
  gstNumber         String?  // India
  msmeNumber        String?  // India
  taxIdType         String?  // EIN | VAT | ABN | UEN | OTHER — generic tax ID slot for non-India countries
  taxIdValue        String?
  beneficiaryName   String?
  bankName          String?
  accountNumber     String?
  ifscCode          String?  // India
  routingNumber     String?  // United States (ABA)
  bsb               String?  // Australia
  iban              String?  // IBAN countries (UK/EU/etc)
  swiftCode         String?
  accountType       String?
  regAddressLine1   String?
  regCity           String?
  regState          String?
  regPostal         String?
  womenOwned        Boolean  @default(false)
  minorityOwned     Boolean  @default(false)
  smallBusiness     Boolean  @default(false)
  completionScore   Int      @default(0)
  validation        Json?    // per-field tax/bank validation results (format/checksum), see lib/validators.ts
  riskDeclarations  Json?    // self-declared risk questionnaire answers (insurance, BCP, anti-bribery policy, legal disputes) — see lib/supplier-risk.ts
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model SupplierDocument {
  id             String         @id @default(uuid())
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type           String         // PAN_CARD | GST_CERTIFICATE | VAT_CERTIFICATE | W9_FORM | W8_FORM | INCORPORATION_CERTIFICATE | MSME_CERTIFICATE | CANCELLED_CHEQUE | BANK_STATEMENT | ISO_CERTIFICATE | INSURANCE_CERTIFICATE | NDA | MSA | OTHER
  name           String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  status         DocumentStatus @default(PENDING)
  expiryDate     DateTime?
  rejectedNote   String?
  verifiedAt     DateTime?
  validationNotes Json?         // automated format/size/cross-check results from lib/document-scan.ts — NOT OCR/authenticity verification
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([supplierId])
  @@index([supplierId, status])
}

// Free-form messages exchanged between the buyer org and a supplier during
// onboarding (fromPortal=true means the supplier sent it via the supplier portal).
model SupplierMessage {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fromPortal Boolean  @default(false)
  senderName String?
  subject    String?
  body       String
  createdAt  DateTime @default(now())

  @@index([supplierId])
}

// ───────────────────────────── Requisitions ─────────────────────────────────

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  MANAGER_APPROVAL
  DIRECTOR_APPROVAL
  PROCUREMENT_REVIEW
  FINANCE_APPROVAL
  APPROVED
  PO_CREATED
  REJECTED
  CANCELLED
}

enum IntakeSource {
  FORM
  CHATBOT
  PUNCHOUT
}

enum RequisitionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Requisition {
  id                String              @id @default(uuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requisitionNumber String
  title             String
  description       String?
  category          String?
  commodity         String?
  priority          RequisitionPriority @default(MEDIUM)
  status            RequisitionStatus   @default(DRAFT)
  intakeSource      IntakeSource        @default(FORM)
  requestorId       String
  requestor         User                @relation("RequisitionRequestor", fields: [requestorId], references: [id])
  businessUnit      String?
  department        String?
  project           String?
  budget            Decimal?            @db.Decimal(14, 2)
  costCenter        String?
  deliveryLocation  String?
  requiredDate      DateTime?
  currency          String              @default("USD")
  totalAmount       Decimal             @default(0) @db.Decimal(14, 2)
  taxAmount         Decimal             @default(0) @db.Decimal(14, 2)
  businessJustification String?
  policyException   Boolean             @default(false)
  policyExceptionNote String?
  chartOfAccountId  String?
  chartOfAccount    ChartOfAccount?     @relation(fields: [chartOfAccountId], references: [id])
  glCoding          Json?
  customFieldAnswers Json?             // Record<fieldKey, value> captured from category-scoped CustomFields
  erpTargetSystem   String?
  erpReferenceId    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  submittedAt       DateTime?
  completedAt       DateTime?

  lineItems     RequisitionLineItem[]
  approvalSteps ApprovalStep[]
  attachments   Attachment[]
  purchaseOrder PurchaseOrder?

  @@index([status])
  @@index([requestorId])
  @@index([organizationId])
  @@unique([organizationId, requisitionNumber])
}

model RequisitionLineItem {
  id                  String      @id @default(uuid())
  requisitionId       String
  requisition         Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  supplierId          String?
  supplier            Supplier?   @relation(fields: [supplierId], references: [id])
  description         String
  partNumber          String?
  category            String?
  commodity           String?
  // SERVICES + AMOUNT means this is a fixed-fee service line: quantity is always
  // stored as 1 and unitPrice holds the total amount, so every downstream total
  // calc (subtotal, PO conversion, revise) keeps working unchanged.
  itemType            RequisitionItemType @default(GOODS)
  pricingType         PricingType @default(QUANTITY)
  unit                String?
  quantity            Decimal     @db.Decimal(12, 2)
  unitPrice           Decimal     @db.Decimal(12, 2)
  lineTotal           Decimal     @db.Decimal(14, 2)
  taxRate             Decimal     @default(0) @db.Decimal(6, 4)
  taxAmount           Decimal     @default(0) @db.Decimal(12, 2)
  glAccount           String?
  costCenter          String?
  contractReference   String?
  notes               String?
  glCoaId             String?
  glCoding            Json?
  createdAt           DateTime    @default(now())
}

model Attachment {
  id            String      @id @default(uuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  uploadedAt    DateTime    @default(now())
}

// ───────────────────────────── Approval Workflow ────────────────────────────

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApprovalStepType {
  MANAGER
  DIRECTOR
  PROCUREMENT
  FINANCE
  CUSTOM
}

model ApprovalStep {
  id            String             @id @default(uuid())
  requisitionId String
  requisition   Requisition        @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stepType      ApprovalStepType
  stepLabel     String?
  sequence      Int
  approverId    String?
  approver      User?              @relation(fields: [approverId], references: [id])
  // When multiple ApprovalStep rows share the same (requisitionId, sequence), they're
  // a parallel group instantiated from one ApprovalRuleStep with multiple approvers.
  // approverMode governs how the group resolves: ANY = first response (approve or
  // reject) decides for the whole group; ALL = every member must approve, and a
  // single reject from anyone still kills the whole requisition.
  approverMode  String             @default("ANY")
  status        ApprovalStepStatus @default(PENDING)
  comment       String?
  decidedAt     DateTime?
  createdAt     DateTime           @default(now())

  @@index([requisitionId])
  @@index([approverId, status])
}

model ApprovalRule {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  // Labels which flow this rule applies to. Only REQUISITION is actually consumed by
  // an execution engine today (intake submission creates a Requisition, which is the
  // same flow) — other values are accepted for forward compatibility but not yet
  // wired to a real approval-consuming workflow.
  module         String       @default("REQUISITION")
  priority       Int          @default(100)
  active         Boolean      @default(true)
  minAmount      Decimal?     @db.Decimal(14, 2)
  maxAmount      Decimal?     @db.Decimal(14, 2)
  category       String?
  department     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  steps ApprovalRuleStep[]

  @@index([organizationId, active, priority])
}

model ApprovalRuleStep {
  id              String           @id @default(uuid())
  ruleId          String
  rule            ApprovalRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  sequence        Int
  stepType        ApprovalStepType
  stepLabel       String?
  assignedUserId  String?          // legacy single-approver case (kept for backward compatibility)
  approverUserIds String[]         @default([]) // when non-empty: a parallel step — these specific people, not stepType-based routing
  approverMode    String           @default("ANY") // ANY = first response wins | ALL = every listed approver must approve
  createdAt       DateTime         @default(now())

  @@index([ruleId])
}

// ───────────────────────────── Purchase Orders ──────────────────────────────

enum POStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum PORoutingMethod {
  EMAIL
  CXML
  MANUAL
}

enum RequisitionItemType {
  GOODS
  SERVICES
}

enum PricingType {
  QUANTITY
  AMOUNT
}

model PurchaseOrder {
  id               String          @id @default(uuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poNumber         String
  requisitionId    String?         @unique
  requisition      Requisition?    @relation(fields: [requisitionId], references: [id])
  supplierId       String?
  supplier         Supplier?       @relation(fields: [supplierId], references: [id])
  createdById      String
  createdBy        User            @relation("POCreatedBy", fields: [createdById], references: [id])
  status           POStatus        @default(DRAFT)
  routingMethod    PORoutingMethod @default(EMAIL)
  supplierEmail    String?
  cxmlEndpoint     String?
  currency         String          @default("USD")
  subtotal         Decimal         @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal         @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal         @default(0) @db.Decimal(14, 2)
  paymentTerms     String?
  deliveryAddress  String?
  notes            String?
  chartOfAccountId String?
  chartOfAccount   ChartOfAccount? @relation(fields: [chartOfAccountId], references: [id])
  glCoding         Json?
  issuedAt         DateTime?
  acknowledgedAt   DateTime?
  expectedDelivery DateTime?
  // 0 = original PO. Incremented each time a "Revise" (change order) is sent —
  // re-transmits the updated PO to the supplier without needing a whole new PO row.
  changeOrderNumber Int            @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  lineItems PurchaseOrderLineItem[]

  @@index([organizationId])
  @@index([status])
  @@unique([organizationId, poNumber])
}

model PurchaseOrderLineItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])
  description     String
  itemType        RequisitionItemType @default(GOODS)
  pricingType     PricingType @default(QUANTITY)
  unit            String?
  quantity        Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal       @db.Decimal(12, 2)
  lineTotal       Decimal       @db.Decimal(14, 2)
  glAccount       String?
  receivedQty     Decimal       @default(0) @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
}

// ───────────────────────────── Admin: Custom Fields ─────────────────────────

enum CustomFieldEntity {
  REQUISITION
  SUPPLIER
  PURCHASE_ORDER
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
  TEXTAREA
}

model CustomField {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         CustomFieldEntity
  name           String
  fieldKey       String
  fieldType      CustomFieldType
  required       Boolean           @default(false)
  options        String[]
  categories     String[]          @default([]) // Lookup(type=CATEGORY) labels this field applies to; empty = all categories
  conditions     Json?             // Dynamic Questionnaire Engine: e.g. {"country":["India"],"riskLevel":["HIGH","CRITICAL"]} — AND-matched against the entity; empty/null = always applicable
  helpText       String?
  sortOrder      Int               @default(0)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, entity])
  @@unique([organizationId, entity, fieldKey])
}

// ───────────────────────── Admin: Roles & Permissions ───────────────────────

model WorkspaceRole {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  permissions    Json         @default("{}")
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  userRoles      WorkspaceRoleMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model WorkspaceRoleMember {
  id        String        @id @default(uuid())
  userId    String
  roleId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      WorkspaceRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ─────────────────────────── Admin: Content Groups ───────────────────────────

model ContentGroup {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  color          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members        ContentGroupMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ContentGroupMember {
  id             String       @id @default(uuid())
  contentGroupId String
  userId         String
  contentGroup   ContentGroup @relation(fields: [contentGroupId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([contentGroupId, userId])
  @@index([contentGroupId])
  @@index([userId])
}

// ─────────────────────── User ↔ Chart of Accounts access ────────────────────

model UserChartOfAccount {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chartOfAccountId String
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([userId, chartOfAccountId])
  @@index([userId])
  @@index([chartOfAccountId])
}

// ───────────────────────────── Admin: Lookups ───────────────────────────────

model Lookup {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  code           String
  label          String
  parentCode     String?
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  coaId          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, type])
  @@unique([organizationId, type, code])
}

// ───────────────────────── Admin: Chart of Accounts ──────────────────────────

model ChartOfAccount {
  id                  String         @id @default(uuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  code                String
  companyCode         String?
  currency            String         @default("INR")
  description         String?
  billingContact      String?
  billingEmail        String?
  billingPhone        String?
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingState        String?
  billingPostal       String?
  billingCountry      String?
  taxRegNumber        String?
  taxType             String?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  segments       CoaSegment[]
  requisitions   Requisition[]
  purchaseOrders PurchaseOrder[]
  userAccess     UserChartOfAccount[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model CoaSegment {
  id               String         @id @default(uuid())
  chartOfAccountId String
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Cascade)
  position         Int
  name             String
  description      String?
  isRequired       Boolean        @default(false)
  linkedLookupType String?
  createdAt        DateTime       @default(now())

  values           CoaSegmentValue[]

  @@unique([chartOfAccountId, position])
  @@index([chartOfAccountId])
}

model CoaSegmentValue {
  id          String     @id @default(uuid())
  segmentId   String
  segment     CoaSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  code        String
  description String
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  @@unique([segmentId, code])
  @@index([segmentId])
}

// ───────────────────────────── Integrations ─────────────────────────────────
// Stores per-organisation connection status and credentials for third-party
// integrations: Coupa, SAP Ariba, Ivalua, GEP, Zycus, JAGGAER,
// SAP S/4HANA, Oracle ERP, NetSuite, Dynamics 365, Workday, Slack, Teams, etc.

model Integration {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String       // e.g. "coupa", "sap_ariba", "oracle_erp", "netsuite"
  name           String       // display name, e.g. "Coupa"
  status         String       @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR | PAUSED
  config         Json?        // API keys, base URLs, tokens (encrypt at rest in production)
  lastSyncAt     DateTime?
  lastError      String?
  syncCount      Int          @default(0)
  errorCount     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  logs           IntegrationLog[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

// Per-integration event log — tracks every sync, error, and connection event
model IntegrationLog {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  level         String      @default("INFO")    // INFO | SUCCESS | WARN | ERROR
  event         String                           // CONNECTED | SYNC_START | SYNC_SUCCESS | SYNC_ERROR | DISCONNECTED
  message       String
  meta          Json?
  createdAt     DateTime    @default(now())

  @@index([integrationId])
  @@index([createdAt])
  @@index([level])
}

// ───────────────────────────── Catalogs & Punchout ───────────────────────────
// A Catalog is either a HOSTED item list (managed in-app, browsable, ordered
// directly) or a PUNCHOUT connection to a supplier's own hosted catalog via
// the cXML PunchOut protocol (buyer is redirected to the supplier's site and
// the resulting cart is returned via a PunchOutOrderMessage callback).

enum CatalogType {
  HOSTED
  PUNCHOUT
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

model Catalog {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           CatalogType
  status         CatalogStatus @default(ACTIVE)
  description    String?
  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])

  // PUNCHOUT-only cXML connection config (null for HOSTED catalogs)
  punchoutUrl        String? // supplier's PunchOutSetupRequest endpoint
  cxmlFromDomain     String?
  cxmlFromIdentity   String? // buyer identity as registered with the supplier
  cxmlToDomain       String?
  cxmlToIdentity     String? // supplier identity
  cxmlSenderDomain   String?
  cxmlSenderIdentity String? // credential used to authenticate — often same as From
  cxmlSharedSecret   String? // shared secret / password — never returned by the API
  cxmlOptions        Json?   // escape hatch for nonstandard protocol needs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    CatalogItem[]
  sessions PunchoutSession[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, type, status])
}

model CatalogItem {
  id          String   @id @default(uuid())
  catalogId   String
  catalog     Catalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  description String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  category    String?
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  itemType    RequisitionItemType @default(GOODS)
  unit        String?
  leadDays    Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([catalogId, sku])
  @@index([catalogId])
  @@index([supplierId])
}

enum PunchoutSessionStatus {
  PENDING
  RETURNED
  EXPIRED
  ERROR
}

// Tracks an outstanding cXML punchout round-trip. The BuyerCookie is the
// only correlation mechanism for the return callback — the supplier's site
// posts back through the buyer's own browser, so no session cookie can be
// relied on to identify who/what org/which catalog this belongs to.
model PunchoutSession {
  id              String                @id @default(uuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogId       String
  catalog         Catalog               @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  requestorId     String
  requestor       User                  @relation(fields: [requestorId], references: [id])
  buyerCookie     String                @unique
  status          PunchoutSessionStatus @default(PENDING)
  startPageUrl    String?
  returnedCartXml String?               @db.Text
  errorMessage    String?
  requisitionId   String?
  createdAt       DateTime              @default(now())
  expiresAt       DateTime

  @@index([organizationId])
  @@index([catalogId])
  @@index([buyerCookie])
}

// ─────────────────────────────── OAuth2 API Clients ──────────────────────────
// Admins create API clients so external systems (Coupa, SAP, ERPs) can
// authenticate using OAuth 2.0 Client Credentials and call /api/v1/* routes.

model ApiClient {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  clientId         String       @unique // e.g. vlt_client_xxxx
  clientSecretHash String       // SHA-256 of the plain-text secret — never stored in clear
  scopes           String[]     // e.g. ["requisitions:read", "suppliers:write"]
  active           Boolean      @default(true)
  lastUsedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tokens           ApiToken[]

  @@index([organizationId])
  @@index([clientId])
}

// Issued OAuth 2.0 bearer tokens — hash stored, raw token returned once to caller
model ApiToken {
  id          String    @id @default(uuid())
  apiClientId String
  apiClient   ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique // SHA-256 of the raw bearer token
  scopes      String[]
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([apiClientId])
  @@index([tokenHash])
}


// ───────────────────────────── Agents ───────────────────────────────────────

enum AgentAutonomy {
  SUGGEST      // writes are queued for a human to approve
  ACT_NOTIFY   // agent acts, and each action shows in the inbox for review
  AUTO         // agent acts; recorded in the run history and audit trail only
}

enum AgentRunStatus {
  RUNNING
  WAITING_HUMAN  // finished, but has actions awaiting approval
  COMPLETED
  FAILED
}

enum AgentActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model AgentRun {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentKey       String
  trigger        String         // SCHEDULE | MANUAL | EVENT
  status         AgentRunStatus @default(RUNNING)
  input          Json?
  summary        String?
  error          String?
  // [{ thought, tool, input, result }] — the agent's full working, for audit.
  steps          Json?
  llmCalls       Int            @default(0)
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?

  actions        AgentAction[]

  @@index([organizationId, startedAt])
}

model AgentAction {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId          String
  run            AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentKey       String
  tool           String
  input          Json
  rationale      String?
  status         AgentActionStatus @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  result         Json?
  error          String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, status])
  @@index([runId])
}


// ───────────────────────────── Contracts ────────────────────────────────────

enum ContractStatus {
  DRAFT
  NEGOTIATION
  PENDING_APPROVAL
  PENDING_SIGNATURE
  ACTIVE          // fully signed and published to the repository
  EXPIRED
  TERMINATED
  CANCELLED
}

enum ContractSignatoryStatus {
  PENDING
  SIGNED
  DECLINED
}

model Contract {
  id                String         @id @default(uuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractNumber    String
  title             String
  type              String         // MSA | NDA | SOW | PURCHASE_AGREEMENT | SLA | OTHER
  status            ContractStatus @default(DRAFT)
  supplierId        String?
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  ownerId           String
  owner             User           @relation("ContractOwner", fields: [ownerId], references: [id])
  description       String?
  value             Decimal?       @db.Decimal(14, 2)
  currency          String         @default("INR")
  startDate         DateTime?
  endDate           DateTime?
  autoRenew         Boolean        @default(false)
  noticeDays        Int            @default(60)
  currentVersion    Int            @default(1)
  approverId        String?        // who was asked to approve (null = any eligible approver)
  approvedById      String?
  approvedAt        DateTime?
  publishedAt       DateTime?
  terminatedAt      DateTime?
  terminationReason String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  versions          ContractVersion[]
  comments          ContractComment[]
  signatories       ContractSignatory[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId, status])
  @@index([organizationId, endDate])
}

// Every edit is a new immutable version, so negotiation history and exactly
// what each party signed can always be reproduced.
model ContractVersion {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionNumber Int
  body          String   @db.Text
  changeNote    String?
  source        String   // HUMAN | AGENT | SUPPLIER
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@unique([contractId, versionNumber])
}

model ContractComment {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  authorType    String   // BUYER | SUPPLIER | AGENT
  authorName    String
  body          String   @db.Text
  internal      Boolean  @default(false) // internal notes are never shown to the supplier
  versionNumber Int?
  createdAt     DateTime @default(now())

  @@index([contractId, createdAt])
}

// One person who must sign. They get an unguessable link — only its SHA-256
// hash is stored — so external parties never need an account.
model ContractSignatory {
  id             String                  @id @default(uuid())
  contractId     String
  contract       Contract                @relation(fields: [contractId], references: [id], onDelete: Cascade)
  party          String                  // BUYER | SUPPLIER
  name           String
  email          String
  title          String?
  status         ContractSignatoryStatus @default(PENDING)
  tokenHash      String                  @unique
  signedName     String?
  signedAt       DateTime?
  signedIp       String?
  signedUserAgent String?
  signedVersion  Int?
  signedDocHash  String?                 // SHA-256 of the exact text that was signed
  declineReason  String?
  invitedAt      DateTime?
  createdAt      DateTime                @default(now())

  @@index([contractId])
}

// The negotiation playbook: standard wording, approved fallbacks and guidance
// the negotiation agent measures a counterparty's draft against.
model ContractClause {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  category       String       // e.g. Payment, Liability, Termination, Confidentiality
  body           String       @db.Text
  fallbackBody   String?      @db.Text
  required       Boolean      @default(false)
  guidance       String?      @db.Text
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, category])
}


// ───────────────────────────── Sourcing (RFx) ───────────────────────────────

enum SourcingStatus {
  DRAFT
  OPEN         // published; invited suppliers can bid until the deadline
  EVALUATION   // bidding closed; buyer compares bids
  AWARDED
  CANCELLED
}

enum SourcingInviteStatus {
  INVITED
  VIEWED
  SUBMITTED
  DECLINED
}

model SourcingEvent {
  id                String         @id @default(uuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventNumber       String
  title             String
  type              String         @default("RFQ") // RFQ | RFP | RFI
  description       String?        @db.Text
  category          String?
  currency          String         @default("INR")
  status            SourcingStatus @default(DRAFT)
  deadline          DateTime?
  requiredDate      DateTime?
  deliveryLocation  String?
  terms             String?        @db.Text
  // [{ id, text, required }] — extra questions suppliers answer alongside their prices.
  questions         Json?
  // The bid-evaluator agent's write-up: { summary, recommendedInviteId, notes: [{ inviteId, note }] }
  evaluation        Json?
  requisitionId     String?
  ownerId           String
  owner             User           @relation("SourcingOwner", fields: [ownerId], references: [id])
  awardedInviteId   String?
  awardedAt         DateTime?
  awardReason       String?
  awardedContractId String?
  awardedPoId       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  items             SourcingItem[]
  invites           SourcingInvite[]

  @@unique([organizationId, eventNumber])
  @@index([organizationId, status])
}

model SourcingItem {
  id            String        @id @default(uuid())
  eventId       String
  event         SourcingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sequence      Int
  description   String
  quantity      Decimal       @db.Decimal(12, 2)
  unit          String?
  specification String?       @db.Text
  // Internal benchmark. Never shown to suppliers.
  targetPrice   Decimal?      @db.Decimal(12, 2)

  bidLines      SourcingBidLine[]

  @@index([eventId])
}

// One invited supplier. Also the credential: their personal bid link is a random
// token whose SHA-256 hash is stored here, so they never need an account.
model SourcingInvite {
  id             String               @id @default(uuid())
  eventId        String
  event          SourcingEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier?            @relation(fields: [supplierId], references: [id])
  name           String
  contactName    String?
  email          String
  tokenHash      String               @unique
  status         SourcingInviteStatus @default(INVITED)
  invitedAt      DateTime?
  viewedAt       DateTime?
  declineReason  String?
  createdAt      DateTime             @default(now())

  bid            SourcingBid?

  @@index([eventId])
}

// A supplier's response. One live bid per invite; resubmitting before the
// deadline replaces it and bumps `revision`.
model SourcingBid {
  id           String         @id @default(uuid())
  inviteId     String         @unique
  invite       SourcingInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  totalAmount  Decimal        @db.Decimal(14, 2)
  currency     String
  leadTimeDays Int?
  paymentTerms String?
  validityDays Int?
  notes        String?        @db.Text
  answers      Json?          // { [questionId]: answer }
  revision     Int            @default(1)
  submittedAt  DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  lines        SourcingBidLine[]
}

model SourcingBidLine {
  id           String       @id @default(uuid())
  bidId        String
  bid          SourcingBid  @relation(fields: [bidId], references: [id], onDelete: Cascade)
  itemId       String
  item         SourcingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitPrice    Decimal      @db.Decimal(12, 2)
  leadTimeDays Int?
  notes        String?

  @@unique([bidId, itemId])
}
